		<menuitem>
		<itemlabel>Georegions Example</itemlabel>
			<message>
				<title>Georegions</title>
					<objectparameters>
						<georegions>
							<region>
								<position lon="-71.973253" lat="44.764393"/>
								<position lon="-71.949319" lat="44.796868"/>
								<position lon="-71.958176" lat="44.800632"/>
								<position lon="-71.982112" lat="44.767850"/>
							</region>
							<region>
								This region definition contains a <em>label text</em>, that describes the region definition.<br />
								In this case the <b>Central Park</b> in New York City
								<position lon="-73.973253" lat="40.764393"/>
								<position lon="-73.949319" lat="40.796868"/>
								<position lon="-73.958176" lat="40.800632"/>
								<position lon="-73.982112" lat="40.767850"/>
							</region>
						</georegions>
					</objectparameters>
			</message>
		</menuitem>

