# Production Environment Variables
NODE_ENV=production
PORT=5001

# MongoDB Connection - ปรับตามโฮสติ้ง
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/journaline-reader
# หรือ localhost ถ้าติดตั้ง MongoDB บนเซิร์ฟเวอร์
MONGODB_URI=mongodb://localhost:27017/journaline-reader

# JWT Secret - เปลี่ยนเป็นค่าที่ปลอดภัย!
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# API Configuration
CORS_ORIGIN=*
