{
  "name": "journaline-reader-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npx concurrently \"nodemon server.js\" \"vite\"",
    "d": "npm run dev",
    "build": "node -e \"const fs=require('node:fs'); if(!fs.existsSync('dist/index.html')){console.error('dist/index.html missing. Build locally and upload dist/.'); process.exit(1);} console.log('dist ok');\"",
    "build:ui": "tsc -b && vite build",
    "b": "npm run build:ui",
    "preview": "vite preview",
    "start": "node app.js",
    "s": "npm start",
    "server": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:clean": "docker-compose down -v"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "fast-xml-parser": "^4.3.2",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.11.5",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.1.4",
    "jsdom": "^29.0.2",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.4"
  }
}
