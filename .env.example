# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/journaline-reader
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/journaline-reader

# JWT Secret Key (use strong random string for production)
JWT_SECRET=your-secret-key-change-this-in-production

# Server Port
PORT=5004

# Environment
NODE_ENV=development

# Admin Credentials (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
